# LOCAL development example only. Copy to .env and fill in your own credentials.
# Render: use existing environment variables and retain the existing /var/data disk.
NODE_ENV=development
PORT=3000
DATA_DIR=./data
ADMIN_NAME=Aacharya Sudheer
ADMIN_EMAIL=
ADMIN_PASSWORD=
SESSION_SECRET=
PARENT_SESSION_SECRET=
DB_BACKUP_KEEP=20
MAX_PROOF_BYTES=5242880
INVITE_VALID_DAYS=7
COURSE_GRACE_DAYS=7
# Production fresh install only; never set this to bypass a missing existing DB.
# INIT_NEW_DATABASE=true
